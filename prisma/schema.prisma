// Inactive VO-1 ledger. No provider payload or customer-input digest retained.
model AddressVerificationOperation {
  id             String                       @id @db.Uuid
  accountId      String                       @db.Uuid
  tenantId       String                       @db.Uuid
  conversationId String                       @db.Uuid
  sessionId      String                       @db.Uuid
  intentId       String                       @db.Uuid
  revision       Int
  policyHash     String
  state          String                       @default("RESERVED")
  heldMicros     BigInt
  createdAt      DateTime                     @default(now()) @db.Timestamptz(3)
  attemptId      String?                      @db.Uuid
  executionDeadline DateTime? @db.Timestamptz(3)
  requests       AddressVerificationRequest[]

  @@unique([accountId, tenantId, sessionId, intentId, revision, policyHash], map: "AddressOperation_binding_key")
  @@index([accountId, state])
}

model AddressVerificationRequest {
  id          String                       @id @db.Uuid
  operationId String                       @db.Uuid
  operation   AddressVerificationOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//
// NOTE: Prisma does not support partial unique indexes in schema.
// After migrating, apply the SQL in the "Hardened SQL Indexes" section at the end.
//


// =====================================================
// TENANT
// =====================================================

model TenantOrganization {
  id                      String   @id @default(uuid()) @db.Uuid
  name                    String
  status                  TenantStatus @default(ACTIVE)
  timezone                String
  settings                Json     @default("{}")
  stripeCustomerId        String?
  stripeConnectAccountId  String?
  connectOnboardingStatus ConnectOnboardingStatus @default(NOT_STARTED)
  chargesEnabled          Boolean  @default(false)
  payoutsEnabled          Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  users                   User[]
  subscriptions           TenantSubscription[]
  serviceCategories       ServiceCategory[]
  customers               Customer[]
  propertyAddresses       PropertyAddress[]
  conversations           Conversation[]
  jobs                    Job[]
  payments                Payment[]
  stripeEvents            StripeEvent[]
  auditLogs               AuditLog[]
  ledgerEntries           LedgerEntry[]
  serviceAreas            ServiceArea[]
  coverageChecks          CustomerCoverageCheck[]
  communicationEvents     CommunicationEvent[]
  communicationContents   CommunicationContent[]
  smsConsentRecords       SmsConsentRecord[]
  smsEnqueueIntents        SmsEnqueueIntent[]
  appointmentEmailIntents AppointmentEmailIntent[]
  appointmentCancellationSnapshots AppointmentCancellationSnapshot[]
  calendarOperations      CalendarOperation[]
  conversationJobLinks    ConversationJobLink[]
  emailConsentScopes      AppointmentEmailConsentScope[]
  jobOffers               JobOffer[]
  userAvailabilityBlocks  UserAvailabilityBlock[]
  userServiceCapabilities UserServiceCapability[]
  routingRules            RoutingRule[]
}


// =====================================================
// USERS / RBAC
// =====================================================

model User {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email       String
  fullName    String
  role        UserRole
  status      UserStatus @default(ACTIVE)

  // Keep optional; uniqueness is enforced via a partial unique index in SQL migration (recommended).
  phone       String?
  isAvailable Boolean  @default(false)
  isOnCall    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs                   Job[]
  availabilityBlocks     UserAvailabilityBlock[]
  serviceCapabilities    UserServiceCapability[]
  jobOffers              JobOffer[]
  auditLogs              AuditLog[]

  // Composite uniqueness for tenant-scope identity
  @@unique([tenantId, email])
  @@unique([id, tenantId]) // enables composite FK references
  @@index([tenantId])
}


// =====================================================
// TENANT SUBSCRIPTION (SaaS billing)
// =====================================================

model TenantSubscription {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  tenant               TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  stripeSubscriptionId String
  status               SubscriptionStatus
  planId               String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, stripeSubscriptionId])
  @@unique([id, tenantId])
  @@index([tenantId])
}


// =====================================================
// SERVICE CATALOG + CAPABILITY
// =====================================================

model ServiceCategory {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String   @db.Uuid
  tenant                   TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name                     String
  basePriceCents           Int      @default(0)
  emergencySurchargeCents  Int      @default(0)
  estimatedDurationMinutes Int      @default(60)

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  jobs                    Job[]
  userServiceCapabilities UserServiceCapability[]
  routingRules            RoutingRule[]

  @@unique([id, tenantId])
  @@index([tenantId])
}


// =====================================================
// CUSTOMERS + ADDRESSES
// =====================================================

model Customer {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  tenant           TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  phone            String
  fullName         String
  email            String?
  aiMetadata       Json?
  consentToText    Boolean  @default(false)
  consentToTextAt  DateTime?
  marketingOptIn   Boolean  @default(false)
  marketingOptInAt DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  propertyAddresses PropertyAddress[]
  conversations     Conversation[]
  jobs              Job[]

  @@unique([tenantId, phone])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model PropertyAddress {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  tenant            TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId        String   @db.Uuid
  customerTenantId  String   @db.Uuid
  customer          Customer @relation(fields: [customerId, customerTenantId], references: [id, tenantId], onDelete: Cascade)

  googlePlaceId     String
  formattedAddress  String
  addressComponents Json
  latitude          Float
  longitude         Float
  accessNotes       String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  jobs              Job[]
  coverageChecks    CustomerCoverageCheck[]

  @@unique([tenantId, googlePlaceId])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([customerId, customerTenantId])
}


// =====================================================
// COVERAGE
// =====================================================

model ServiceArea {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name       String
  type       ServiceAreaType
  definition Json
  status     ServiceAreaStatus @default(ACTIVE)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  coverageChecks CustomerCoverageCheck[]
  routingRules   RoutingRule[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model CustomerCoverageCheck {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  tenant            TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  propertyAddressId       String   @db.Uuid
  propertyAddressTenantId String   @db.Uuid
  propertyAddress         PropertyAddress @relation(fields: [propertyAddressId, propertyAddressTenantId], references: [id, tenantId], onDelete: Cascade)

  serviceAreaId     String?  @db.Uuid
  serviceAreaTenantId String? @db.Uuid
  serviceArea       ServiceArea? @relation(fields: [serviceAreaId, serviceAreaTenantId], references: [id, tenantId], onDelete: SetNull)

  status            CoverageStatus
  reasonCode        CoverageReasonCode
  metadata          Json?
  checkedAt         DateTime @default(now())

  @@unique([id, tenantId])
  @@index([tenantId, propertyAddressId, checkedAt])
  @@index([serviceAreaId, serviceAreaTenantId])
}


// =====================================================
// CONVERSATIONS + LINK TO JOBS
// =====================================================

model Conversation {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  tenant          TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId      String   @db.Uuid
  customerTenantId String  @db.Uuid
  customer        Customer @relation(fields: [customerId, customerTenantId], references: [id, tenantId], onDelete: Cascade)

  channel         ConversationChannel
  status          ConversationStatus
  currentFSMState String
  collectedData   Json?

  providerConversationId String?
  twilioCallSid          String?
  twilioSmsSid           String?

  startedAt       DateTime @default(now())
  endedAt         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  communicationEvents CommunicationEvent[]
  jobLinks            ConversationJobLink[]
  emailConsentScopes  AppointmentEmailConsentScope[]
  fixtureSmsConsentState FixtureSmsConsentState?

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([customerId, customerTenantId])
}

model ConversationJobLink {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  tenant               TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  conversationId       String   @db.Uuid
  conversationTenantId String   @db.Uuid
  conversation         Conversation @relation(fields: [conversationId, conversationTenantId], references: [id, tenantId], onDelete: Cascade)

  jobId                String   @db.Uuid
  jobTenantId          String   @db.Uuid
  job                  Job @relation(fields: [jobId, jobTenantId], references: [id, tenantId], onDelete: Cascade)

  relationType         ConversationJobRelation
  createdAt            DateTime @default(now())

  @@unique([tenantId, conversationId, jobId])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([conversationId, conversationTenantId])
  @@index([jobId, jobTenantId])
}


// =====================================================
// JOBS + OFFERS (DISPATCH)
// =====================================================

model Job {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId       String  @db.Uuid
  customerTenantId String  @db.Uuid
  customer         Customer @relation(fields: [customerId, customerTenantId], references: [id, tenantId], onDelete: Cascade)

  propertyAddressId       String  @db.Uuid
  propertyAddressTenantId String  @db.Uuid
  propertyAddress         PropertyAddress @relation(fields: [propertyAddressId, propertyAddressTenantId], references: [id, tenantId], onDelete: Cascade)

  serviceCategoryId       String  @db.Uuid
  serviceCategoryTenantId String  @db.Uuid
  serviceCategory         ServiceCategory @relation(fields: [serviceCategoryId, serviceCategoryTenantId], references: [id, tenantId], onDelete: Cascade)

  assignedUserId       String? @db.Uuid
  assignedUserTenantId String? @db.Uuid
  assignedUser         User? @relation(fields: [assignedUserId, assignedUserTenantId], references: [id, tenantId], onDelete: SetNull)

  status          JobStatus
  technicianStatus TechnicianJobStatus?
  technicianStatusUpdatedAt DateTime?
  urgency         JobUrgency
  description     String?
  intakeSessionId String? @db.VarChar(64)

  pricingSnapshot Json
  policySnapshot  Json

  preferredWindowLabel PreferredWindowLabel?
  preferredTimeText    String? @db.VarChar(160)
  serviceWindowStart   DateTime?
  serviceWindowEnd     DateTime?
  calendarEventId      String? @db.VarChar(256)

  offerExpiresAt  DateTime?
  acceptedAt      DateTime?
  completedAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  jobOffers           JobOffer[]
  payment             Payment?
  ledgerEntries       LedgerEntry[]
  communicationEvents CommunicationEvent[]
  conversationLinks   ConversationJobLink[]
  emailConsentBinding AppointmentEmailConsentBinding?
  smsEnqueueIntents    SmsEnqueueIntent[]
  appointmentEmailIntents AppointmentEmailIntent[]
  appointmentCancellationSnapshots AppointmentCancellationSnapshot[]
  calendarOperations  CalendarOperation[]

  @@unique([id, tenantId])
  @@unique([tenantId, intakeSessionId])
  @@index([tenantId])
  @@index([tenantId, status, urgency])
  @@index([assignedUserId, assignedUserTenantId])
  @@index([tenantId, assignedUserId, technicianStatus])
  @@index([customerId, customerTenantId])
  @@index([propertyAddressId, propertyAddressTenantId])
  @@index([serviceCategoryId, serviceCategoryTenantId])
  @@unique([tenantId, serviceWindowStart, serviceWindowEnd])
}

model JobOffer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  jobId       String  @db.Uuid
  jobTenantId String  @db.Uuid
  job         Job @relation(fields: [jobId, jobTenantId], references: [id, tenantId], onDelete: Cascade)

  offeredToUserId       String? @db.Uuid
  offeredToUserTenantId String? @db.Uuid
  offeredToUser         User? @relation(fields: [offeredToUserId, offeredToUserTenantId], references: [id, tenantId], onDelete: SetNull)

  channel     JobOfferChannel
  status      JobOfferStatus
  tokenHash   String
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, tokenHash])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([jobId, jobTenantId, status])
  @@index([offeredToUserId, offeredToUserTenantId, status])
}


// =====================================================
// SCHEDULING
// =====================================================

model UserAvailabilityBlock {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId       String  @db.Uuid
  userTenantId String  @db.Uuid
  user         User @relation(fields: [userId, userTenantId], references: [id, tenantId], onDelete: Cascade)

  type      AvailabilityBlockType
  startAt   DateTime
  endAt     DateTime
  rrule     String?
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId, userTenantId])
}

model UserServiceCapability {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId       String  @db.Uuid
  userTenantId String  @db.Uuid
  user         User @relation(fields: [userId, userTenantId], references: [id, tenantId], onDelete: Cascade)

  serviceCategoryId       String @db.Uuid
  serviceCategoryTenantId String @db.Uuid
  serviceCategory         ServiceCategory @relation(fields: [serviceCategoryId, serviceCategoryTenantId], references: [id, tenantId], onDelete: Cascade)

  proficiency ProficiencyLevel
  isEnabled   Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, userId, serviceCategoryId])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId, userTenantId])
  @@index([serviceCategoryId, serviceCategoryTenantId])
}

model RoutingRule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  status    RoutingRuleStatus @default(ACTIVE)
  priority  Int @default(100)

  serviceCategoryId       String? @db.Uuid
  serviceCategoryTenantId String? @db.Uuid
  serviceCategory         ServiceCategory? @relation(fields: [serviceCategoryId, serviceCategoryTenantId], references: [id, tenantId], onDelete: Cascade)

  serviceAreaId       String? @db.Uuid
  serviceAreaTenantId String? @db.Uuid
  serviceArea         ServiceArea? @relation(fields: [serviceAreaId, serviceAreaTenantId], references: [id, tenantId], onDelete: Cascade)

  urgency              JobUrgency?
  timeScope             RoutingTimeScope @default(ANY)
  requireAvailable      Boolean @default(true)
  requireOnCall         Boolean @default(false)
  escalateToOwner       Boolean @default(false)
  escalateToOnCall      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId, status, priority])
  @@index([serviceCategoryId, serviceCategoryTenantId])
  @@index([serviceAreaId, serviceAreaTenantId])
}


// =====================================================
// PAYMENTS + LEDGER + WEBHOOKS
// =====================================================

model Payment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // NOTE: do NOT mark jobId @unique globally. Use tenant-scoped uniqueness below.
  jobId       String  @db.Uuid
  jobTenantId String  @db.Uuid
  job         Job @relation(fields: [jobId, jobTenantId], references: [id, tenantId], onDelete: Cascade)

  status                    PaymentStatus
  stripePaymentIntentId     String?
  stripeCheckoutSessionId   String?
  requestKeyHash            String? @db.VarChar(64)
  checkoutExpiresAt         DateTime?
  requestedAt               DateTime?
  stripeChargeId            String?
  destinationAccountId      String?
  amountTotalCents          Int
  applicationFeeAmountCents Int
  currency                  String @default("usd")
  refundStatus              RefundStatus @default(NONE)
  refundAmountCents         Int?
  stripeRefundId            String?
  refundReason              String?
  transferGroup             String?
  transferId                String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  ledgerEntries LedgerEntry[]

  @@unique([tenantId, jobId])
  @@unique([jobId, jobTenantId])
  @@unique([tenantId, requestKeyHash])
  @@unique([id, tenantId])

  // Keep these indexed; enforce uniqueness "when NOT NULL" via hardened SQL indexes.
  @@index([tenantId, stripePaymentIntentId])
  @@index([tenantId, stripeCheckoutSessionId])
  @@index([tenantId, stripeChargeId])
  @@index([tenantId, stripeRefundId])
  @@index([tenantId, transferId])

  @@index([tenantId])
  @@index([jobId, jobTenantId])
}

model LedgerEntry {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  jobId       String? @db.Uuid
  jobTenantId String? @db.Uuid
  job         Job? @relation(fields: [jobId, jobTenantId], references: [id, tenantId], onDelete: SetNull)

  paymentId       String? @db.Uuid
  paymentTenantId String? @db.Uuid
  payment         Payment? @relation(fields: [paymentId, paymentTenantId], references: [id, tenantId], onDelete: SetNull)

  type        LedgerEntryType
  amountCents Int
  currency    String @default("usd")
  description String
  createdAt   DateTime @default(now())

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([jobId, jobTenantId])
  @@index([paymentId, paymentTenantId])
}

model StripeEvent {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  tenant           TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  stripeEventId    String
  type             String
  payload          Json
  processingStatus StripeEventStatus @default(PENDING)
  receivedAt       DateTime @default(now())
  processedAt      DateTime?
  errorMessage     String?

  @@unique([tenantId, stripeEventId])
  @@unique([id, tenantId])
  @@index([tenantId])
}


// =====================================================
// COMMUNICATION LOGGING (EVENT + CONTENT)
// =====================================================

model CommunicationEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  conversationId       String? @db.Uuid
  conversationTenantId String? @db.Uuid
  conversation         Conversation? @relation(fields: [conversationId, conversationTenantId], references: [id, tenantId], onDelete: SetNull)

  jobId       String? @db.Uuid
  jobTenantId String? @db.Uuid
  job         Job? @relation(fields: [jobId, jobTenantId], references: [id, tenantId], onDelete: SetNull)

  channel        CommunicationChannel
  direction      CommunicationDirection
  provider       CommunicationProvider
  externalId     String?
  idempotencyKeyHash String?
  status         CommunicationStatus
  attemptCount   Int @default(0)
  nextAttemptAt  DateTime?
  lastErrorCode  String?
  terminalAt     DateTime?
  redactionLevel RedactionLevel @default(PARTIAL)

  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  content CommunicationContent?
  enqueueIntents SmsEnqueueIntent[]

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKeyHash])
  @@unique([tenantId, provider, externalId])
  @@index([tenantId, occurredAt])
  @@index([status, nextAttemptAt])
  @@index([conversationId, conversationTenantId, occurredAt])
  @@index([jobId, jobTenantId, occurredAt])
}

enum CalendarOperationAction {
  CREATE
  RESCHEDULE
  CANCEL
}

enum CalendarOperationStatus {
  PENDING
  UNCERTAIN
  APPLIED
  NEEDS_REVIEW
  FINALIZED
  ABORTED
}

// Persistence foundation only. The migration also owns CHECK constraints and
// a partial unique index permitting only one unfinished operation per job.
model CalendarOperation {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  jobId String @db.Uuid
  job Job @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  action CalendarOperationAction
  status CalendarOperationStatus @default(PENDING)
  calendarId String @db.VarChar(1024)
  calendarEventId String @db.VarChar(256)
  timeZone String @db.VarChar(128)
  expectedUpdatedAt DateTime
  claimedUpdatedAt DateTime
  previousStatus JobStatus
  previousCalendarEventId String? @db.VarChar(256)
  previousWindowStart DateTime?
  previousWindowEnd DateTime?
  previousTimeText String? @db.VarChar(160)
  desiredWindowStart DateTime?
  desiredWindowEnd DateTime?
  desiredTimeText String? @db.VarChar(160)
  // Frozen when reviewed UNCERTAIN admission advances updatedAt. Null legacy
  // rows retain the updatedAt + grace fallback; never a provider-write lease.
  readbackNotBefore DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

enum SmsEnqueueIntentStatus {
  PENDING
  QUEUED
  STALE
  FAILED
}

model SmsEnqueueIntent {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobId String @db.Uuid
  job Job @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Cascade)
  templateKey String @db.VarChar(64)
  stateHash String @db.VarChar(64)
  status SmsEnqueueIntentStatus @default(PENDING)
  attemptCount Int @default(0)
  nextAttemptAt DateTime @default(now())
  lastErrorCode String? @db.VarChar(64)
  communicationEventId String? @db.Uuid
  communicationEvent CommunicationEvent? @relation(fields: [communicationEventId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, tenantId])
  @@unique([tenantId, jobId, templateKey, stateHash])
  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
}

model CommunicationContent {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @db.Uuid
  tenant                TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  communicationEventId       String @db.Uuid
  communicationEventTenantId String @db.Uuid
  communicationEvent         CommunicationEvent @relation(fields: [communicationEventId, communicationEventTenantId], references: [id, tenantId], onDelete: Cascade)

  templateId   String?
  payload      Json
  encryptedRaw String?
  createdAt    DateTime @default(now())

  @@unique([tenantId, communicationEventId])
  @@unique([communicationEventId, communicationEventTenantId])
  @@unique([id, tenantId])
  @@index([tenantId])
}

model SmsConsentRecord {
  id       String             @id @default(uuid()) @db.Uuid
  tenantId String             @db.Uuid
  tenant   TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  phoneHash         String
  status            SmsConsentStatus
  source            SmsConsentSource
  disclosureVersion String
  evidenceAt        DateTime
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([tenantId, phoneHash])
  @@index([tenantId, status])
}

// Inactive isolated fixture evidence. Never read by production SMS eligibility.
model FixtureSmsConsentState {
  tenantId String @db.Uuid
  conversationId String @db.Uuid
  conversation Conversation @relation(fields: [conversationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sessionId String @db.VarChar(64)
  encryptedPolicy String
  revision Int @default(1)
  prompts FixtureSmsConsentPrompt[]
  @@id([tenantId, conversationId])
  @@unique([conversationId, tenantId])
  @@unique([tenantId, conversationId, sessionId])
}

model FixtureSmsConsentPrompt {
  id String @id @db.Uuid
  tenantId String @db.Uuid
  conversationId String @db.Uuid
  sessionId String @db.VarChar(64)
  state FixtureSmsConsentState @relation(fields: [tenantId, conversationId, sessionId], references: [tenantId, conversationId, sessionId], onDelete: Restrict)
  encryptedSnapshot String
  issuedAt DateTime
  expiresAt DateTime
  recordedAt DateTime?
  sourceAuditId String? @db.Uuid
  sourceAudit AuditLog? @relation(fields: [sourceAuditId, tenantId], references: [id, tenantId], onDelete: Restrict)
  @@unique([sourceAuditId, tenantId])
  @@index([tenantId, conversationId, expiresAt])
}


// =====================================================
// AUDIT
// =====================================================

// A claim snapshot is not a finalized event or a delivery instruction.
model AppointmentCancellationSnapshot {
  tenantId String @db.Uuid
  tenant TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobId String @db.Uuid
  job Job @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Cascade)
  claimedUpdatedAt DateTime
  previousUpdatedAt DateTime
  customerId String @db.Uuid
  intakeSessionId String? @db.VarChar(64)
  windowStart DateTime
  windowEnd DateTime
  calendarEventHash String @db.Char(64)
  createdAt DateTime @default(now())

  @@id([tenantId, jobId, claimedUpdatedAt])
}

// Inactive evidence foundation. No customer collection, verification or delivery.
model AppointmentEmailConsentScope {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String @db.Uuid
  conversation Conversation @relation(fields: [conversationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sessionId String @db.VarChar(64)
  intakeCustomerId String @db.Uuid
  createdAt DateTime @default(now())
  evidence AppointmentEmailConsentEvidence[]
  binding AppointmentEmailConsentBinding?

  @@unique([id, tenantId])
  @@unique([tenantId, conversationId])
  @@unique([tenantId, sessionId])
}

model AppointmentEmailConsentEvidence {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  scopeId String @db.Uuid
  scope AppointmentEmailConsentScope @relation(fields: [scopeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  sourceAuditId String @db.Uuid
  sourceAudit AuditLog @relation(fields: [sourceAuditId, tenantId], references: [id, tenantId], onDelete: Restrict)
  revision Int
  decision String @db.VarChar(16)
  purpose String @default("APPOINTMENT_UPDATES_V1") @db.VarChar(32)
  promptVersion String @db.VarChar(32)
  interactionId String @db.Uuid
  encryptedEmail String
  mailboxFingerprint String @db.Char(64)
  fingerprintKeyVersion String @db.VarChar(32)
  createdAt DateTime @default(now())

  @@unique([scopeId, revision])
  @@unique([sourceAuditId, tenantId])
  @@unique([tenantId, interactionId])
}

model AppointmentEmailConsentBinding {
  scopeId String @id @db.Uuid
  tenantId String @db.Uuid
  scope AppointmentEmailConsentScope @relation(fields: [scopeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  jobId String @unique @db.Uuid
  job Job @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  jobCustomerId String @db.Uuid
  originLinkId String @db.Uuid
  createdAt DateTime @default(now())
  @@unique([scopeId, tenantId])
  @@unique([jobId, tenantId])
}

model AppointmentEmailIntent {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobId String @db.Uuid
  job Job @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Cascade)
  sourceAuditId String @db.Uuid
  sourceAudit AuditLog @relation(fields: [sourceAuditId, tenantId], references: [id, tenantId], onDelete: Cascade)
  version Int @default(1)
  kind String @default("APPOINTMENT_CONFIRMED") @db.VarChar(64)
  state String @default("RECORDED") @db.VarChar(32)
  source String @db.VarChar(32)
  calendarOperationId String? @db.Uuid
  customerId String @db.Uuid
  intakeSessionId String? @db.VarChar(64)
  jobUpdatedAt DateTime
  windowStart DateTime
  windowEnd DateTime
  calendarEventHash String @db.Char(64)
  tenantSettingsUpdatedAt DateTime
  preference String @db.VarChar(16)
  createdAt DateTime @default(now())

  @@unique([sourceAuditId, tenantId])
  @@unique([tenantId, jobId, kind, jobUpdatedAt])
  @@index([tenantId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  action      String
  actorType   AuditActorType
  actorUserId       String? @db.Uuid
  actorUserTenantId String? @db.Uuid
  actorUser   User? @relation(fields: [actorUserId, actorUserTenantId], references: [id, tenantId], onDelete: SetNull)

  actorId     String
  entityType  String
  entityId    String
  metadata    Json?
  traceId     String?
  appointmentEmailIntents AppointmentEmailIntent[]
  createdAt   DateTime @default(now())
  emailConsentEvidence AppointmentEmailConsentEvidence[]
  fixtureSmsConsentPrompts FixtureSmsConsentPrompt[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([actorUserId, actorUserTenantId])
}


