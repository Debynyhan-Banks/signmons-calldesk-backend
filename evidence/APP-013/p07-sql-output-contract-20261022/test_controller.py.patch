+    def test_sql_contract_decision_is_pinned_to_preimplementation_approval(self):
+        self.assertEqual(c.SQL_CONTRACT_SOURCE_HEAD,'a16513f0f9433adebdf3c978a6bfbfefdf4fd55a')
+        self.assertEqual(c.SQL_CONTRACT_PROPOSAL_SHA,c.git_file_sha(c.GOV,c.SQL_CONTRACT_SOURCE_HEAD,c.SQL_CONTRACT_PROPOSAL_NAME))
+
+    def test_role_boundary_query_is_read_only_and_rejects_legacy_or_extra_output(self):
+        sql=c.role_boundary_sql('2026-10-23 00:00:00+00')
+        self.assertTrue(sql.startswith('BEGIN TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY;'))
+        self.assertTrue(sql.endswith('ROLLBACK;'))
+        c.validate_role_boundary(c.ROLE_BOUNDARY_EXPECTED)
+        for row in ['t|f|f|f|f|f|f|6|t|0|0',c.ROLE_BOUNDARY_EXPECTED+'|extra','']:
+            with self.assertRaises(c.Stop):c.validate_role_boundary(row)
