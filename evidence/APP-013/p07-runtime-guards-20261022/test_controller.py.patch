+    def child_signal(self,signum=None,repeated=False,timeout_input=False):
+        source=str(Path(__file__).with_name('controller.py'))
+        with tempfile.TemporaryDirectory() as root:
+            script=r"""
+import importlib.util,pathlib,sys,time,datetime as dt,json
+s=importlib.util.spec_from_file_location('c',sys.argv[1]);c=importlib.util.module_from_spec(s);s.loader.exec_module(c)
+c.ROOT=pathlib.Path(sys.argv[2]);short=sys.argv[3]=='short';now=time.time();times=[now-1,now+1,now+(0.3 if short else 10),now+15,now+20,now+3600]
+b={'_times':tuple(dt.datetime.fromtimestamp(x,dt.timezone.utc) for x in times),'retirementDeadlineUtc':'synthetic'}
+def close(password):
+    (c.ROOT/'cleanup-started').write_text('yes');time.sleep(0.25)
+def gc(args,**kw):
+    if args[:3]!=['run','services','describe']:raise RuntimeError('EXTERNAL_COMMAND_FORBIDDEN')
+    return {'status':{'traffic':[{'percent':100,'revisionName':c.NORMAL}]}}
+def preflight():
+    (c.ROOT/'first-input-complete').write_text('yes');c.private_input('Synthetic second hidden input: ')
+c.close_role=close;c.gc=gc;c.cloud_preflight=preflight
+raise SystemExit(c.run_operation(b))
+"""
+            master,slave=pty.openpty();before=termios.tcgetattr(master)
+            child=subprocess.Popen([sys.executable,'-B','-c',script,source,root,'short' if timeout_input else 'normal'],stdin=slave,stdout=subprocess.PIPE,stderr=subprocess.PIPE,start_new_session=True)
+            os.close(slave)
+            try:
+                deadline=time.monotonic()+3
+                while termios.tcgetattr(master)[3]&termios.ECHO:
+                    if child.poll() is not None or time.monotonic()>deadline:self.fail('child did not enter hidden input')
+                    time.sleep(0.01)
+                os.write(master,b'synthetic\n')
+                while not (Path(root)/'first-input-complete').exists() or termios.tcgetattr(master)[3]&termios.ECHO:
+                    if child.poll() is not None or time.monotonic()>deadline:self.fail('child second hidden input not entered')
+                    time.sleep(0.01)
+                if signum is not None:os.kill(child.pid,signum)
+                if repeated:
+                    while not (Path(root)/'cleanup-started').exists():
+                        if child.poll() is not None or time.monotonic()>deadline:self.fail('child cleanup not entered')
+                        time.sleep(0.01)
+                    os.kill(child.pid,signal.SIGTERM);os.kill(child.pid,signal.SIGINT)
+                out,err=child.communicate(timeout=4)
+                self.assertEqual(child.returncode,1,(out,err));self.assertIn(b'CONTAINMENT_VERIFIED',out)
+                self.assertTrue((Path(root)/'cleanup-started').exists())
+                receipt=json.loads((Path(root)/'controller-stop.json').read_text())
+                self.assertEqual(receipt['status'],'P07_STOP_READINESS_WINDOW_CLOSED' if timeout_input else 'P07_STOP_INTERRUPTED')
+                self.assertEqual(receipt['containmentFailures'],[])
+                self.assertEqual(termios.tcgetattr(master),before)
+            finally:
+                if child.poll() is None:child.kill();child.communicate(timeout=2)
+                if child.stdout:child.stdout.close()
+                if child.stderr:child.stderr.close()
+                os.close(master)
