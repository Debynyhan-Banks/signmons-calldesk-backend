+const require=createRequire('/Users/debynyhanbanks/Web Projects/signmons-backend-r08-recovery/package.json');
+const { Client }=require('pg');
+
+export async function readRuntime(input, ClientType=Client) {
+  if (!input || typeof input.password!=='string' || !input.password || typeof input.sql!=='string') throw Error('input');
+  const host='ep-jolly-flower-ayc6w9hv.c-5.us-east-2.aws.neon.tech';
+  const client=new ClientType({host,port:5432,database:'neondb',user:'p06_intake_runtime',password:input.password,
+    ssl:{rejectUnauthorized:true,servername:host},connectionTimeoutMillis:8000,query_timeout:35000,
+    application_name:'signmons_p07_exact_runtime_read',
+    options:'-c statement_timeout=20s -c lock_timeout=5s -c default_transaction_read_only=on -c search_path=public'});
+  try {
+    await client.connect();
+    const result=await client.query(input.sql);
+    const rows=(Array.isArray(result)?result:[result]).flatMap(x=>x.rows??[]);
+    const lines=rows.map(row=>{
+      const values=Object.values(row);
+      if(values.length!==1 || typeof values[0]!=='string' || !/^[A-Za-z0-9_|]+$/.test(values[0])) throw Error('result');
+      return values[0];
+    });
+    return lines.join('\n');
+  } finally { await client.end(); }
+}
