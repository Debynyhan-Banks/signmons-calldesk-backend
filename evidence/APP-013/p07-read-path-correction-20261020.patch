+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { readRuntime } from './db-runtime-read.mjs';
+
+test('direct restricted pg connection requires certificate and hostname verification and closes',async()=>{
+  let options,ended=false,sql;
+  class Client {constructor(x){options=x}async connect(){}async query(x){sql=x;return [{rows:[]},{rows:[{identity:'neondb|p06_intake_runtime|p06_intake_runtime'}]},{rows:[{facts:'1|t|t'}]},{rows:[]}]}async end(){ended=true}}
+  const query='BEGIN READ ONLY; SELECT 1; ROLLBACK;';
+  assert.equal(await readRuntime({password:'FICTIONAL-only',sql:query},Client),'neondb|p06_intake_runtime|p06_intake_runtime\n1|t|t');
+  assert.equal(options.user,'p06_intake_runtime');assert.equal(options.database,'neondb');
+  assert.equal(options.ssl.rejectUnauthorized,true);assert.equal(options.ssl.servername,options.host);
+  assert.match(options.options,/default_transaction_read_only=on/);assert.equal(sql,query);assert.equal(ended,true);
+});
+test('query failure still closes the restricted client',async()=>{
+  let ended=false;
+  class Client {async connect(){}async query(){throw Error('FICTIONAL-private-diagnostic')}async end(){ended=true}}
+  await assert.rejects(readRuntime({password:'FICTIONAL-only',sql:'BEGIN READ ONLY;'},Client));assert.equal(ended,true);
+});
+test('unexpected result shape refuses instead of emitting raw private values',async()=>{
+  let ended=false;
+  class Client {async connect(){}async query(){return {rows:[{unexpected:'private url with spaces'}]}}async end(){ended=true}}
+  await assert.rejects(readRuntime({password:'FICTIONAL-only',sql:'SELECT 1;'},Client),/result/);assert.equal(ended,true);
+});
